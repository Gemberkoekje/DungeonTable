# Copy to .env and fill in. The real .env is gitignored.
# Consumed by docker-compose.yml.

# PostgreSQL (Marten document store). The compose file builds the app's connection string from these;
# the app reads it as ConnectionStrings__Postgres. Without a connection string the app still runs, but
# the reveal state and any running fight are lost on restart and the DM screen says "Not saved".
POSTGRES_USER=dungeontable
POSTGRES_PASSWORD=
POSTGRES_DB=dungeontable
POSTGRES_PORT=5432

# Web host published port.
WEBAPP_PORT=8080

# Shared passphrase gating the whole app (HTTP Basic auth, any user name). Required: the app refuses
# to start without one. For local non-docker development, set it with
# `dotnet user-secrets set "Auth:Passphrase" ... --project DungeonTable.Web` instead.
AUTH_PASSPHRASE=

# The content to run: the folder holding Maps/ and data/. Leave it empty for the sample pack.
CONTENT_DIR=
