<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DungeonTable.Tests</RootNamespace>
    <!-- xUnit v3 test projects are self-executing. -->
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <!--
      CA1707: identifiers should not contain underscores.
      [Justification: test methods use the Method_Scenario_Expectation naming style, which
       reads best with underscores. Suppressed for the test project only; production code
       keeps the rule.]
    -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DungeonTable.Application/DungeonTable.Application.csproj" />
    <ProjectReference Include="../DungeonTable.Core/DungeonTable.Core.csproj" />
    <ProjectReference Include="../DungeonTable.Infrastructure/DungeonTable.Infrastructure.csproj" />
    <ProjectReference Include="../DungeonTable.Web/DungeonTable.Web.csproj" />
  </ItemGroup>

</Project>
