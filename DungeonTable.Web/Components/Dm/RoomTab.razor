@inherits DmTabBase
@inject CampaignState Campaign
@*
    The dock's Room tab: the room the DM is looking at, beside the map, in the order it is read at the
    table (RoomReading). Clicking a room on the map shows it here; nothing about that reaches the
    players.

    The header carries what the old context rail beside the map carried: the title and area number,
    whether the room is cleared and whether the players can see it, and the actions on the room itself
    (reveal it, frame the projector on it, centre the DM's map on it). Back and forward walk the same
    history the card sheet's breadcrumb does.

    The header's ⓘ opens the floor's standing facts under it (LevelFacts: what dwells here, the factions,
    the wandering monsters), so "who else is on this floor" is answered without the Campaign tab.

    The tab follows the party: walk the token into a room and the room is here. Looking at another room
    lasts until the party moves on, and a strip above the header says so and goes back (Esc); the pin
    keeps the dock where the DM put it while the party moves (DmWorkspace.FollowParty).
*@

<div class="room-tab">
    @if (Workspace.PanelNode.Length == 0)
    {
        <p class="muted room-empty">Click a room on the map to read it here.</p>
    }
    else
    {
        @if (Workspace.LookingAway)
        {
            <div class="room-follow" role="status">
                @if (Workspace.Pinned)
                {
                    <span><span aria-hidden="true">&#x1F4CC;</span> Pinned here. The party is in <strong>@Workspace.LabelFor(Workspace.PartyArea)</strong>.</span>
                }
                else
                {
                    <span>Looking at <strong>@Workspace.PanelTitle</strong>. The party is in <strong>@Workspace.LabelFor(Workspace.PartyArea)</strong>.</span>
                }
                <button type="button" class="room-follow-back"
                        title="@(Workspace.Pinned ? "Show the party's room and follow the party again" : "Show the party's room (Esc)")"
                        @onclick="Workspace.BackToParty">Back to the party's room</button>
            </div>
        }

        <header class="room-head">
            <div class="room-head-top">
                @if (Workspace.History.Entries.Count > 1)
                {
                    <span class="room-steps">
                        <button type="button" class="nav-step" disabled="@(!Workspace.History.CanBack)"
                                title="Back (Alt+Left)" aria-label="Back" @onclick="Workspace.NavigateBack">&larr;</button>
                        <button type="button" class="nav-step" disabled="@(!Workspace.History.CanForward)"
                                title="Forward (Alt+Right)" aria-label="Forward" @onclick="Workspace.NavigateForward">&rarr;</button>
                    </span>
                }

                @if (Workspace.AreaDossier.AreaNumber > 0)
                {
                    <span class="room-number">Area @Workspace.AreaDossier.AreaNumber</span>
                }

                @if (PartyHere)
                {
                    <span class="room-chip party" title="The party token stands in this room">
                        <span aria-hidden="true">&#x25C9;</span> party here
                    </span>
                }

                @if (AreaCleared)
                {
                    <span class="room-chip cleared" title="Every creature this area names has been ticked off">
                        <span aria-hidden="true">&#x2714;</span> cleared
                    </span>
                }

                @if (Workspace.RoomRevealed())
                {
                    <span class="room-chip revealed" title="The players can see this room">
                        <span aria-hidden="true">&#x25CD;</span> revealed
                    </span>
                }

                <span class="room-actions">
                    @if (HasLevelFacts)
                    {
                        <button type="button" class="room-action level-info @(levelOpen ? "on" : string.Empty)"
                                aria-pressed="@(levelOpen ? "true" : "false")" aria-controls="room-level"
                                title="This floor's standing facts: what dwells here, its factions, its wandering monsters"
                                @onclick="() => levelOpen = !levelOpen">
                            <span aria-hidden="true">&#x24D8;</span> Floor
                        </button>
                    }
                    @if (Workspace.RoomRegionIds.Count > 0)
                    {
                        <button type="button" class="room-action @(Workspace.RoomRevealed() ? "on" : string.Empty)"
                                aria-pressed="@(Workspace.RoomRevealed() ? "true" : "false")"
                                title="@(Workspace.RoomRevealed() ? "Hide this room from the players" : "Reveal this room to the players")"
                                @onclick="Workspace.ToggleRoomReveal">
                            <span aria-hidden="true">&#x25CD;</span> @(Workspace.RoomRevealed() ? "Hide" : "Reveal")
                        </button>
                    }
                    <button type="button" class="room-action" disabled="@(!Workspace.MapLoaded)"
                            title="Frame the projector on this room" @onclick="Workspace.FrameShownArea">
                        <span aria-hidden="true">&#x2922;</span> Frame
                    </button>
                    <button type="button" class="room-action" disabled="@(!Workspace.MapLoaded)"
                            title="Centre your map on this room" @onclick="ShowOnMap">
                        <span aria-hidden="true">&#x2316;</span> Centre
                    </button>
                    @if (Session.Party.IsPlaced)
                    {
                        <button type="button" class="room-action pin @(Workspace.Pinned ? "on" : string.Empty)"
                                aria-pressed="@(Workspace.Pinned ? "true" : "false")"
                                title="@(Workspace.Pinned ? "Follow the party again" : "Keep the dock here when the party moves")"
                                @onclick="Workspace.TogglePin">
                            <span aria-hidden="true">&#x1F4CC;</span> @(Workspace.Pinned ? "Pinned" : "Pin")
                        </button>
                    }
                </span>
            </div>

            <h2 class="room-title">@Workspace.PanelTitle</h2>

            @if (Workspace.MapLoaded && Workspace.RoomRegionIds.Count == 0)
            {
                <p class="muted room-unmapped">No region on this map is linked to this room yet.</p>
            }
        </header>

        @if (levelOpen && HasLevelFacts)
        {
            <section class="room-level" id="room-level" aria-label="This floor">
                <LevelFacts Level="Workspace.LevelDossier" ShowAftermath="false" Pinnable="true"
                            ResolveRefs="Workspace.ResolveRefs" OnOpenReference="Workspace.OpenReference" />
            </section>
        }

        @if (!string.IsNullOrEmpty(Workspace.RegionNotice))
        {
            <p class="muted" role="status">@Workspace.RegionNotice</p>
        }

        @if (!string.IsNullOrEmpty(Workspace.ErrorMessage))
        {
            <p class="error" role="alert">@Workspace.ErrorMessage</p>
        }
        else
        {
            <RoomReading Briefing="Workspace.Briefing"
                         Dossier="Workspace.AreaDossier"
                         Encounter="EncounterSlot"
                         Nearby="NearbySlot"
                         Note="NoteSlot"
                         OnOpenReference="Workspace.OpenReference"
                         ResolveRefs="Workspace.ResolveRefs"
                         ResolveRefsOn="Workspace.ResolveRefsOn" />
        }
    }
</div>

@code {
    /// <summary>Raised with a world point when the DM asks to centre their map on the shown room.</summary>
    [Parameter]
    public EventCallback<MapPoint> OnShowOnMap { get; set; }

    // The checklist, read from the shown area: derived rather than stored, as the encounter strip
    // derives it, so the chip and the strip can never disagree about whether a room is done.
    private bool AreaCleared =>
        Workspace.Encounter.Count > 0
        && Workspace.Encounter.All(monster => CreatureStanding.Of(Workspace.PanelNode, monster, Campaign).Gone);

    // The floor's ⓘ stays as the DM left it from room to room: it is about the floor, not the room.
    private bool levelOpen;

    private bool HasLevelFacts =>
        !string.IsNullOrWhiteSpace(Workspace.LevelDossier.WhatDwellsHere)
        || Workspace.LevelDossier.Factions.Count > 0
        || Workspace.LevelDossier.WanderingMonsters.Count > 0;

    private bool PartyHere =>
        Workspace.PanelNode.Length > 0
        && string.Equals(Workspace.PartyArea, Workspace.PanelNode, StringComparison.Ordinal);

    private RenderFragment EncounterSlot => @<EncounterStrip Monsters="Workspace.Encounter"
                                                            AreaNodeId="@Workspace.PanelNode"
                                                            AreaTitle="@Workspace.PanelTitle"
                                                            OnOpenReference="Workspace.OpenReference"
                                                            AreaLabel="Workspace.LabelFor" />;

    private RenderFragment NearbySlot => @<NearbyRooms Rooms="NearbyLines()"
                                                       OnNavigate="Workspace.NavigateTo"
                                                       OnOpenReference="Workspace.OpenReference"
                                                       ResolveRefs="Workspace.ResolveRefs" />;

    // The room's ways out, each with what is in the room it leads to, as it stands now: the badges read
    // the checklist and notes, which is why the tab listens to the campaign.
    private NearbyRoom[] NearbyLines() =>
        Workspace.Briefing.Connections
            .Select(exit =>
            {
                RoomGlance glance = Workspace.GlanceOf(exit.TargetRoomId);
                return new NearbyRoom(exit, glance, RoomBadges.For(glance, Campaign));
            })
            .ToArray();

    private RenderFragment NoteSlot => @<AreaNotes AreaNodeId="@Workspace.PanelNode" AreaTitle="@Workspace.PanelTitle" />;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        base.OnInitialized();

        // DmTabBase watches the workspace and the session; the ticks behind the cleared chip and the
        // Nearby badges, and the notes, live on the campaign, which the encounter strip changes.
        Campaign.Changed += OnCampaignChanged;
    }

    /// <inheritdoc />
    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            Campaign.Changed -= OnCampaignChanged;
        }

        base.Dispose(disposing);
    }

    private void OnCampaignChanged() => InvokeAsync(StateHasChanged);

    private Task ShowOnMap() => OnShowOnMap.InvokeAsync(Workspace.ShownAreaCentre());
}
