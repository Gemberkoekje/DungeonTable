@page "/dm"
@rendermode InteractiveServer
@inject DmWorkspace Workspace
@inject SessionState Session
@inject BattleState Fight
@inject TablePersistence Persistence
@inject LiveContent Live
@inject PartyMoves Party
@inject ProjectorPictures Pictures
@inject IJSRuntime JS
@implements IAsyncDisposable
@*
    The DM screen's shell: the bar across the top, the map on the left, and the dock on the right with
    its four tabs (Room, Battle, Campaign, Art). The map never leaves the screen, so reveals, the
    projector's frame and the doors work whichever dock tab is open; Ctrl+1..4 switch the dock only.

    The shell owns which dock tab is up, the dock's width modes and the bar, and nothing else: the map
    and its tools live in MapPane, the room in RoomTab, the campaign in CampaignTab, cards in
    CardSheet, passages in PassageSheet, the fight in BattleTab, Find anything in FindBox and the pins
    in PinStrip, and every piece of state they share lives in the scoped DmWorkspace (or, for the pins,
    the table's CampaignState) rather than in parameters threaded through here.

    All four dock tabs stay mounted; the inactive ones are hidden with CSS. That is deliberate: a tab
    keeps its scroll position, its half-typed boxes and the fight's open pane when the DM looks
    elsewhere and comes back. It looks like an accident otherwise; it is not.

    The Battle tab has a layout of its own (DockLayout): a wide dock, so the order and a creature's
    detail pane fit side by side, and the map a narrow bird's-eye strip framed on the fight's room
    (MapViewMemory). The reading tabs share the other. Each layout keeps its own dock width, which the DM
    drags (dt-dock.js keeps it per browser, following the shell's layout class), and its own pan and zoom;
    "\" swaps the dock between narrow and wide. Below 1200 px wide the dock slides over the map as a
    drawer, toggled with Tab.
*@

<PageTitle>DM view &mdash; DungeonTable</PageTitle>

@* What the projector shows, read once per render: the DM's map, or the one the DM left while the
   projector stays on it (SessionState.Projector). The bar counts what the players see from this. *@
@{
    ProjectorView projector = Session.Projector();
}

@* The revision re-renders every tab with the shell, in one render, and a dock tab renders only while it
   is up (DmTabBase). *@
<CascadingValue Name="@DmTabBase.RevisionName" Value="revision">
<CascadingValue Name="@DmTabBase.WorkspaceRevisionName" Value="workspaceRevision">
<CascadingValue Name="@DmTabBase.ActiveTabName" Value="activeTab">
@* The picture buttons beside each mention read this (PictureButton); it never changes, so nothing
   renders again for it. *@
<CascadingValue Value="Pictures" IsFixed="true">
<div class="dm-shell @LayoutClass @(drawerOpen ? "drawer-open" : string.Empty)" @ref="shellRef">
    @* The bar belongs to the shell: the DM must be able to see and reframe what the projector shows
       whatever the dock is showing. *@
    <div class="dm-player-bar">
        <span class="players-see @(PlayersSeeAnything(projector) ? "live" : string.Empty)"
              title="What the player projector is currently showing">
            <span class="see-dot" aria-hidden="true">&#x25CF;</span>
            Players see @Count(projector.RevealedRegionIds.Count, "region") &middot; @Count(projector.FogCells.Count, "cell")
        </span>

        <span class="viewport-at" title="@(projector.IsCurrentMap ? "The region under the centre of the player viewport" : "The region under the centre of the Player view box on this map: where the projector looks once this map is on it")">
            <span aria-hidden="true">&#x2922;</span>
            Viewport: @(ViewportName.Length > 0 ? ViewportName : "unmapped")
        </span>

        <button type="button" class="frame-btn" title="Move the player viewport onto the room in the Room tab"
                disabled="@(!Workspace.MapLoaded)" @onclick="Workspace.FrameShownArea">Frame</button>

        @* Following is a setting of the table, off by default: on, the projector frames the party again
           whenever the token leaves the middle of its view (PartyMoves). *@
        <button type="button" class="frame-btn follow-btn @(Session.ProjectorFollowsParty ? "on" : string.Empty)"
                aria-pressed="@(Session.ProjectorFollowsParty ? "true" : "false")"
                title="Follow the party: frame the projector on the party token again whenever it leaves the middle of the view"
                disabled="@(!Workspace.MapLoaded)"
                @onclick="() => Party.SetProjectorFollows(!Session.ProjectorFollowsParty)">
            <span aria-hidden="true">&#x25C9;</span> Follow party
        </button>

        @* The projector's turn and its size in squares are settings of the table too: a turn for a table
           the players sit around, and a size remembered on one map and used on the next, so a square on
           the table stays the size of a miniature's base. *@
        <button type="button" class="frame-btn turn-btn @(Session.PlayerTurns != 0 ? "on" : string.Empty)"
                title="@($"Turn the player view a quarter turn clockwise. Now {Session.PlayerTurns * 90}°")"
                disabled="@(!Workspace.MapLoaded)"
                @onclick="Session.TurnPlayerView">
            <span aria-hidden="true">&#x21BB;</span> @(Session.PlayerTurns == 0 ? "Turn" : $"{Session.PlayerTurns * 90}°")
        </button>

        <span class="view-size" role="group" aria-label="Player view size">
            <button type="button" class="frame-btn"
                    title="@($"Remember the player view's size, {Squares(Workspace.PlayerViewSize())}, to use on another map")"
                    disabled="@(!Workspace.MapLoaded)"
                    @onclick="Workspace.RememberPlayerViewSize">Remember size</button>
            <button type="button" class="frame-btn"
                    title="@(Session.RememberedView.IsSet ? $"Size the player view to the remembered {Squares(Session.RememberedView)}, so a square is the size it was" : "Remember a size first")"
                    disabled="@(!Workspace.MapLoaded || !Session.RememberedView.IsSet)"
                    @onclick="Workspace.UseRememberedViewSize">@UseSizeLabel</button>
        </span>

        @* The picture on the projector belongs in the bar for the same reason the reveal counts do:
           a DM in the middle of a fight must be able to see that a vampire is still on the beamer,
           and take it down, without going to find the tab that put it there. *@
        @if (Session.ShownArtImageId.Length > 0)
        {
            <span class="art-live @(Session.ShownArtVisible ? "live" : string.Empty)"
                  title="The picture staged for the projector">
                <span aria-hidden="true">&#x1F5BC;</span>
                @(Session.ShownArtVisible ? "Art shown" : "Art hidden")
            </span>

            <button type="button" class="art-btn"
                    title="@(Session.ShownArtVisible ? "Take the picture off the projector (h)" : "Put the staged picture back (h)")"
                    @onclick="ToggleArt">@(Session.ShownArtVisible ? "Hide art" : "Show art")</button>
        }

        @* Find anything belongs to the bar, as the frame does: a lookup is wanted whichever dock tab is up. *@
        <button type="button" class="find-open-btn" title="Find anything: rooms, people, rules and words (Ctrl+K or /)"
                @onclick="OpenFind">
            <span aria-hidden="true">&#x2315;</span> Find anything&hellip; <kbd>Ctrl+K</kbd>
        </button>

        <span class="bar-spacer"></span>

        @* Moving to another map does not move the projector: the players go on seeing the map they are
           on, as it was, until the DM shows them this one. Both halves sit by the map picker, where the
           move was made. *@
        @if (!projector.IsCurrentMap)
        {
            <span class="projector-held" role="status"
                  title="The players still see this map. Reveal and frame this one as you like; they see it once you show it.">
                <span aria-hidden="true">&#x23F8;&#xFE0E;</span>
                Projector on @Workspace.MapLabel(projector.MapId)
            </span>

            <button type="button" class="frame-btn show-map-btn"
                    title="Put this map on the projector, with what is revealed on it, framed where its Player view box is"
                    disabled="@(!Workspace.MapLoaded)"
                    @onclick="Session.ShowCurrentMapOnProjector">Show on projector</button>
        }

        <select class="map-picker" aria-label="Map"
                title="The map you are on. The projector stays on its own map until you press Show on projector."
                @bind="selectedMapId" @bind:after="LoadMap">
            @foreach (string id in Workspace.MapIds)
            {
                <option value="@id">@Workspace.MapLabel(id)</option>
            }
        </select>

        @* Whether the evening is being saved. A DM should never have to guess, and finding out after
           a restart that nothing was persisted is exactly the surprise persistence exists to remove. *@
        <span class="table-saved @SaveClass" title="@SaveTitle">
            <span aria-hidden="true">@SaveGlyph</span>
            @SaveLabel
        </span>

        <button type="button" class="drawer-btn" aria-expanded="@(drawerOpen ? "true" : "false")"
                title="Show or hide the dock over the map (Tab)" @onclick="ToggleDrawer">Dock</button>
    </div>

    <div class="dm-body">
        <section class="dm-map" aria-label="Map">
            <MapPane @ref="mapPane" OnLooked="ShowRoom" />
            <FindBox @ref="findBox" OnOpen="OpenFound" />
        </section>

        <div class="dm-divider" role="separator" aria-orientation="vertical" aria-label="Dock width" tabindex="0"
             title="Drag to resize the dock; double-click for the default width"></div>

        <aside class="dm-dock" aria-label="Dock">
            <nav class="dock-tabs" role="tablist" aria-label="Dock">
                @foreach ((DockTab tab, string label) in Tabs)
                {
                    DockTab candidate = tab;
                    <button type="button" role="tab" id="dm-tab-@candidate"
                            class="dock-tab @(activeTab == candidate ? "active" : string.Empty)"
                            aria-selected="@(activeTab == candidate ? "true" : "false")"
                            aria-controls="dm-panel-@candidate"
                            title="@($"{label} (Ctrl+{TabIndex(candidate)})")"
                            @onclick="() => SetTab(candidate)">
                        @label
                        <span class="dock-tab-key" aria-hidden="true">@TabIndex(candidate)</span>
                    </button>
                }

                @* No @onclick: the dock's width is the browser's own (dt-dock.js listens for this button). *@
                <button type="button" class="dock-swap-btn"
                        title="Swap the dock between narrow and wide (\\)">&#x21D4;</button>
            </nav>

            <div class="dock-panels">
                <div class="dock-panel @PanelClass(DockTab.Room)" role="tabpanel" id="dm-panel-Room"
                     aria-labelledby="dm-tab-Room" aria-hidden="@Hidden(DockTab.Room)">
                    <RoomTab OnShowOnMap="CentreMapOn" />
                </div>

                <div class="dock-panel @PanelClass(DockTab.Battle)" role="tabpanel" id="dm-panel-Battle"
                     aria-labelledby="dm-tab-Battle" aria-hidden="@Hidden(DockTab.Battle)">
                    <BattleTab @ref="battleTab" />
                </div>

                <div class="dock-panel @PanelClass(DockTab.Campaign)" role="tabpanel" id="dm-panel-Campaign"
                     aria-labelledby="dm-tab-Campaign" aria-hidden="@Hidden(DockTab.Campaign)">
                    <CampaignTab OnShowRoom="ShowRoom" />
                </div>

                <div class="dock-panel @PanelClass(DockTab.Art)" role="tabpanel" id="dm-panel-Art"
                     aria-labelledby="dm-tab-Art" aria-hidden="@Hidden(DockTab.Art)">
                    <ArtTab @ref="artTab" />
                </div>

                @if (SheetShown)
                {
                    <CardSheet OnShowRoom="ShowRoom" />
                }

                @* A passage is a lookup over whatever the dock shows, a card included, so Esc puts it away
                   and the card or the room is still there. *@
                @if (PassageShown)
                {
                    <PassageSheet OnShowRoom="ShowRoom" />
                }
            </div>

            <PinStrip @ref="pinStrip" OnOpened="RevealDock" />
        </aside>
    </div>
</div>
</CascadingValue>
</CascadingValue>
</CascadingValue>
</CascadingValue>

@code {
    private static readonly (DockTab Tab, string Label)[] Tabs =
    {
        (DockTab.Room, "Room"),
        (DockTab.Battle, "Battle"),
        (DockTab.Campaign, "Campaign"),
        (DockTab.Art, "Art"),
    };

    // How far the map zooms in when the Room tab's Centre action brings a room to the middle. Modest
    // on purpose: the DM keeps their bearings better than a hard zoom to the room's own bounds allows.
    private const double CentreZoom = 1.6;

    private DockTab activeTab = DockTab.Room;
    private MapPane mapPane;
    private FindBox findBox;
    private PinStrip pinStrip;
    private BattleTab battleTab;
    private ArtTab artTab;
    private ElementReference shellRef;
    private string selectedMapId = string.Empty;
    private bool drawerOpen;

    // The map's pan and zoom per layout, and when the fight's room is framed. A change of layout is
    // carried out after the render that made it, so the map is measured at its new width.
    private readonly MapViewMemory views = new MapViewMemory();
    private MapViewChange pendingView = MapViewChange.None;
    private MapBounds pendingFight;

    private DotNetObjectReference<DmView> selfRef;

    // The revisions cascaded to the tabs (any change; a change of the workspace), and whether a refresh
    // is already waiting (OnStateChanged).
    private int revision;
    private int workspaceRevision;
    private int refreshQueued;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnStateChanged;
        Workspace.Changed += OnWorkspaceChanged;
        Persistence.Changed += OnStateChanged;
        Live.Changed += OnContentChanged;

        await Workspace.InitialiseAsync(CancellationToken.None);
        workspaceRevision++;
        selectedMapId = Workspace.CurrentMapId;
    }

    // A document, a map or the art catalogue changed on disk: the workspace reads again what it keeps,
    // on this circuit's own dispatcher so nothing renders from it half-read, and every tab follows.
    private void OnContentChanged(ContentChanges changes) => InvokeAsync(async () =>
    {
        await Workspace.RefreshAsync(changes, CancellationToken.None);
        selectedMapId = Workspace.CurrentMapId;
        StateHasChanged();
    });

    private async Task LoadMap()
    {
        await Workspace.LoadMapAsync(selectedMapId, CancellationToken.None);
    }

    private void SetTab(DockTab tab)
    {
        string fightArea = Fight.IsActive ? Fight.AreaNodeId : string.Empty;
        MapBounds fight = Workspace.AreaSurroundings(fightArea);
        MapViewChange change = views.Change(activeTab, tab, fightArea, fight.Width > 0 && fight.Height > 0);
        if (change != MapViewChange.None)
        {
            pendingView = change;
            pendingFight = fight;
        }

        activeTab = tab;
    }

    private string LayoutClass => MapViewMemory.LayoutOf(activeTab) == DockLayout.Battle ? "layout-battle" : "layout-reading";

    // The map looked at a room, or a link led to one: the room is read on the Room tab. On a narrow
    // screen the dock is a drawer, so it opens to show it.
    private void ShowRoom()
    {
        SetTab(DockTab.Room);
        drawerOpen = true;
    }

    private void ToggleDrawer() => drawerOpen = !drawerOpen;

    // A card is a sheet over the reading tabs. The fight has a detail pane of its own, and the art tray
    // is about pictures, so the sheet waits behind those until the DM comes back. A passage is the same.
    private bool SheetTab => activeTab == DockTab.Room || activeTab == DockTab.Campaign;

    private bool SheetShown => Workspace.CardNode.Length > 0 && SheetTab;

    private bool PassageShown => Workspace.OpenPassage.Key.Length > 0 && SheetTab;

    private void OpenFind() => findBox?.Show();

    // A row of Find anything was opened: a passage as a sheet, anything else as a link would open it.
    private void OpenFound(FindResult row)
    {
        if (row.Kind == FindResultKind.Text)
        {
            Workspace.ShowPassage(row.Target);
        }
        else
        {
            Workspace.OpenReference(row.Target);
        }

        RevealDock();
    }

    // Something was put on the dock, from Find anything or a pin: a room, which is read on the Room tab, or
    // a card or a passage over the dock, which shows over the reading tabs; from the Battle or Art tab the
    // dock goes to the Room tab to show it.
    private void RevealDock()
    {
        if (Workspace.CardNode.Length == 0 && Workspace.OpenPassage.Key.Length == 0)
        {
            ShowRoom();
            return;
        }

        if (!SheetTab)
        {
            SetTab(DockTab.Room);
        }

        drawerOpen = true;
    }

    private static int TabIndex(DockTab tab) => Array.FindIndex(Tabs, entry => entry.Tab == tab) + 1;

    private string PanelClass(DockTab tab) => activeTab == tab ? "dock-panel-active" : "dock-panel-hidden";

    private string Hidden(DockTab tab) => activeTab == tab ? "false" : "true";

    private static bool PlayersSeeAnything(ProjectorView projector) =>
        projector.RevealedRegionIds.Count > 0 || projector.FogCells.Count > 0;

    private static string Count(int count, string noun) => count == 1 ? $"1 {noun}" : $"{count} {noun}s";

    private string ViewportName => Workspace.ViewportRegionName();

    private string UseSizeLabel => Session.RememberedView.IsSet
        ? "Use " + Whole(Session.RememberedView.Across) + "×" + Whole(Session.RememberedView.Down)
        : "Use size";

    // A size in squares as the DM reads it: "24 × 13.5 squares".
    private static string Squares(ViewSize size) => size.IsSet
        ? $"{Tenth(size.Across)} × {Tenth(size.Down)} squares"
        : "no size yet";

    private static string Whole(double squares) => Math.Round(squares).ToString(System.Globalization.CultureInfo.InvariantCulture);

    private static string Tenth(double squares) => Math.Round(squares, 1).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    // ---- The "is this being saved?" indicator ------------------------------------------------

    private TableSaveStatus Save => Persistence.Status();

    private string SaveClass => Save.Kind switch
    {
        TableSaveKind.Saved => "saved",
        TableSaveKind.Failed => "save-failed",
        TableSaveKind.Blocked => "save-failed",
        _ => "save-off",
    };

    private string SaveGlyph => Save.Kind switch
    {
        TableSaveKind.Saved => "✔",   // check mark
        TableSaveKind.Failed => "⚠",  // warning sign
        TableSaveKind.Blocked => "⚠",
        _ => "⊘",                     // circled slash: nothing is being written
    };

    // The browser's distance from UTC, asked for once the circuit is live. Until it answers, and in a
    // static render, the server's own zone stands in.
    private bool browserClockKnown;
    private TimeSpan browserOffset;

    private string SaveLabel => Save.Kind switch
    {
        // The browser's time, not the server's: the DM reads this against the clock on the wall, and
        // the server's clock is UTC in a container.
        TableSaveKind.Saved => $"Saved {WallClock.HoursMinutes(Save.At, ClockOffset(Save.At))}",
        TableSaveKind.Failed => "Save failed",
        TableSaveKind.Blocked => "Save blocked",
        TableSaveKind.Waiting => "Not saved yet",
        _ => "Not saved",
    };

    private string SaveTitle => Save.Message;

    private TimeSpan ClockOffset(DateTimeOffset moment) =>
        browserClockKnown ? browserOffset : TimeZoneInfo.Local.GetUtcOffset(moment);

    // A browser that cannot say keeps the server's zone rather than taking the screen down with it.
    private async Task AskBrowserClockAsync()
    {
        try
        {
            int minutes = await JS.InvokeAsync<int>("dtClock.utcOffsetMinutes");
            browserClockKnown = WallClock.TryOffset(minutes, out browserOffset);
        }
        catch (JSException)
        {
            browserClockKnown = false;
        }
    }

    // Same toggle the Art tab's own button and the "h" shortcut run, so all three agree.
    private void ToggleArt()
    {
        if (Session.ShownArtVisible)
        {
            Session.HideArt();
        }
        else
        {
            Session.ShowStagedArt();
        }
    }

    private Task CentreMapOn(MapPoint point) =>
        mapPane is null ? Task.CompletedTask : mapPane.CenterOnAsync(point.X, point.Y, CentreZoom);

    // The workspace is this circuit's own and changes on its dispatcher. A change of it reaches even the
    // hidden dock tabs (DmTabBase), which a change of the table alone does not.
    private void OnWorkspaceChanged()
    {
        workspaceRevision++;
        OnStateChanged();
    }

    // Every change of the shared state may have moved the party, by this window, another one or an
    // undo, so the workspace follows it first, here on this circuit's own dispatcher. One action often
    // raises several changes (a step of the token moves the party, frames the projector and shows the
    // room it walked into), so a refresh already waiting takes the later ones along: one render, one
    // message to the browser, not one per change.
    private void OnStateChanged()
    {
        if (Interlocked.Exchange(ref refreshQueued, 1) == 1)
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            try
            {
                Workspace.FollowParty();
            }
            finally
            {
                // From here on a change asks for a render of its own: this one may have read too early.
                Interlocked.Exchange(ref refreshQueued, 0);
            }

            revision++;
            StateHasChanged();
        });
    }

    // Register the global keyboard shortcuts and the dock's divider once the circuit is live: Alt+Left /
    // Alt+Right for the reference history, Ctrl+1..4 for the dock and 1-8 for the map's tools.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            await ChangeMapViewAsync();
            return;
        }

        try
        {
            selfRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("dtNavKeys.attach", selfRef);
            await JS.InvokeVoidAsync("dtDmKeys.attach", selfRef);
            await JS.InvokeVoidAsync("dtDock.attach", shellRef);

            await AskBrowserClockAsync();
            if (browserClockKnown && Save.Kind == TableSaveKind.Saved)
            {
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit dropped before interop could run; nothing to register.
        }
        catch (OperationCanceledException)
        {
            // The render was cancelled during teardown.
        }
    }

    // Carry out a change of layout on the map's pan and zoom, now that the render has resized the map.
    private async Task ChangeMapViewAsync()
    {
        if (pendingView == MapViewChange.None || mapPane is null)
        {
            return;
        }

        MapViewChange change = pendingView;
        pendingView = MapViewChange.None;
        try
        {
            await mapPane.ChangeViewAsync(change, pendingFight);
        }
        catch (JSDisconnectedException)
        {
            // The circuit dropped; there is no map left to move.
        }
        catch (OperationCanceledException)
        {
            // The render was cancelled during teardown.
        }
    }

    /// <summary>Invoked from JS for the Alt+Left / Alt+Right history shortcuts.</summary>
    /// <param name="direction">"back" or "forward".</param>
    /// <returns>A task that completes once the view has re-rendered.</returns>
    [JSInvokable]
    public Task NavKey(string direction)
    {
        if (string.Equals(direction, "back", StringComparison.Ordinal))
        {
            Workspace.NavigateBack();
        }
        else if (string.Equals(direction, "forward", StringComparison.Ordinal))
        {
            Workspace.NavigateForward();
        }

        return InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Invoked from JS for the DM screen's shortcuts: <c>"tab:N"</c> (Ctrl+1..4) switches the dock,
    /// <c>"find"</c> (Ctrl+K or /) puts up Find anything, <c>"undo"</c> (Ctrl+Z) takes back the party's
    /// last move,
    /// <c>"tool:N"</c> (a bare 1..8) picks a map tool and <c>"tool:N:keep"</c> (Shift+1..8) keeps a
    /// one-click tool up, <c>"bare:esc"</c> puts the map back in Look and closes what is open in the
    /// dock, <c>"bare:drawer"</c> (Tab, on a narrow screen) opens and closes the dock, <c>"bare:c"</c>
    /// switches the badges on the map off and on, and <c>"bare:n|p|r|h|m"</c> go to whichever dock tab is on show — the turn order on Battle,
    /// the art tray on Art. The bare-letter shortcuts only reach a tab that is actually up, which is
    /// why the routing lives here and not in the key handler.
    /// </summary>
    /// <param name="key">The shortcut token.</param>
    /// <returns>A task that completes once the view has re-rendered.</returns>
    [JSInvokable]
    public Task DmKey(string key)
    {
        if (key.StartsWith("tab:", StringComparison.Ordinal)
            && int.TryParse(key.AsSpan(4), out int tab)
            && tab >= 1 && tab <= Tabs.Length)
        {
            SetTab(Tabs[tab - 1].Tab);
            drawerOpen = true;
        }
        else if (key.StartsWith("tool:", StringComparison.Ordinal) && mapPane is not null)
        {
            string[] parts = key.Split(':');
            if (int.TryParse(parts[1], out int tool))
            {
                mapPane.SelectToolByIndex(tool, parts.Length > 2 && string.Equals(parts[2], "keep", StringComparison.Ordinal));
            }
        }
        else if (string.Equals(key, "bare:esc", StringComparison.Ordinal))
        {
            Escape();
        }
        else if (string.Equals(key, "find", StringComparison.Ordinal))
        {
            OpenFind();
        }
        else if (string.Equals(key, "undo", StringComparison.Ordinal))
        {
            Session.UndoPartyMove();
        }
        else if (string.Equals(key, "bare:drawer", StringComparison.Ordinal))
        {
            ToggleDrawer();
        }
        else if (string.Equals(key, "bare:c", StringComparison.Ordinal))
        {
            // The badges belong to the map, whichever dock tab is on show.
            mapPane?.ToggleBadges();
        }
        else if (key.StartsWith("bare:", StringComparison.Ordinal))
        {
            // A bare letter goes to whichever tab is on show. The Battle and Art tabs both claim
            // n and p, which is safe precisely because this is the only place that decides who
            // gets them — dt-dm-keys.js reports the keystroke and nothing else.
            RouteBare(key[5..]);
        }

        return InvokeAsync(StateHasChanged);
    }

    // Esc always puts the map back in Look, and closes what is open, the topmost first: Find anything, a
    // pin's popover, the passage sheet, the card sheet over the room or the campaign, the fight's detail
    // pane, whatever the art tray has open. On the Room tab, looking at another room than the party's, it
    // goes back to the party's room.
    private void Escape()
    {
        mapPane?.ResetTool();
        if (findBox is not null && findBox.IsOpen)
        {
            findBox.Close();
            return;
        }

        if (pinStrip is not null && pinStrip.CloseOpen())
        {
            return;
        }

        if (PassageShown)
        {
            Workspace.ClosePassage();
            return;
        }

        if (SheetShown)
        {
            Workspace.CloseDrawer();
            return;
        }

        if (activeTab == DockTab.Room && Workspace.LookingAway && !Workspace.Pinned)
        {
            Workspace.BackToParty();
            return;
        }

        RouteBare("esc");
    }

    private void RouteBare(string bare)
    {
        if (activeTab == DockTab.Battle && battleTab is not null)
        {
            battleTab.HandleKey(bare);
        }
        else if (activeTab == DockTab.Art && artTab is not null)
        {
            artTab.HandleKey(bare);
        }
    }

    /// <summary>Detaches the global key listeners and the divider, and unsubscribes from the shared state.</summary>
    /// <returns>A task that completes once teardown is done.</returns>
    public async ValueTask DisposeAsync()
    {
        Session.Changed -= OnStateChanged;
        Workspace.Changed -= OnWorkspaceChanged;
        Persistence.Changed -= OnStateChanged;
        Live.Changed -= OnContentChanged;

        try
        {
            await JS.InvokeVoidAsync("dtNavKeys.detach");
            await JS.InvokeVoidAsync("dtDmKeys.detach");
            await JS.InvokeVoidAsync("dtDock.detach");
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone; the listeners went with it.
        }
        catch (OperationCanceledException)
        {
            // The interop call was cancelled as the circuit tore down.
        }
        catch (InvalidOperationException)
        {
            // Disposed during (pre)static rendering, before interop could attach.
        }
        finally
        {
            selfRef?.Dispose();
        }
    }
}
