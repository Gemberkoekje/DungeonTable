@inherits DmTabBase
@inject PartyMoves Party
@*
    The DM's map, which never leaves the screen: the pannable canvas, a small toolbar over it, the
    active tool's options under the toolbar, and the grid toggle and Clear reveals at its foot.

    A click looks by default (MapTool.Look): a room shows in the dock's Room tab, a door opens or
    closes, and nothing else changes for the players. The tools are for the occasional job. The ones
    that do one thing to one object go back to Look after one click that did something, so the DM is
    never left in the wrong mode; the fog brush and measuring stay until Esc (see ToolSelection).

    Revealing is moving the party: the DM drags the party token, and what the party sees from every
    square on the way is revealed (PartyMoves). Opening a door looks again from the token, so the room
    beyond shows without a second action. The Party tool puts the token down somewhere new without a
    walk (the stairs, a teleport), and clicking the token opens its menu: the vision range.

    The pane is never unmounted, because the canvas keeps its pan and zoom in JS (dt-editor,
    dt-pan-zoom) and re-mounting the SVG would reset the view. The toolbar and the strips are drawn
    over the map rather than beside it, so the canvas keeps its size and a map point keeps its place
    on screen whatever tool is up.
*@

<div class="map-pane">
    @if (!string.IsNullOrEmpty(Workspace.MapError))
    {
        <p class="error map-message" role="alert">@Workspace.MapError</p>
    }
    else if (Workspace.MapLoaded)
    {
        <VectorMapCanvas @ref="canvas" Map="Workspace.Map" ShowGrid="showGrid" ShowObjects="true" Pannable="true"
                         ShowPlayerBox="true"
                         PlayerViewport="Session.PlayerViewport"
                         PlayerAspect="Session.PlayerAspect"
                         PlayerViewportChanged="OnBoxChanged"
                         EnableEditor="true" EditorTool="@EditorToolName()"
                         SecretDoorIds="Workspace.SecretDoorIds" MarkSecretDoors="true"
                         ConcealedObjectIds="Workspace.ConcealedObjectIds"
                         RevealedFeatureIds="Session.RevealedFeatureIds()"
                         OpenDoorIds="Session.OpenDoorIds()" DoubleDoorIds="Workspace.DoubleDoorIds"
                         Fog="BuildFog()"
                         Overlay="BuildOverlay()" CanvasClicked="OnCanvasClicked"
                         FogPainted="OnFogPainted" Measured="OnMeasured"
                         ShowPartyToken="true" Party="Session.Party" PartyVisionRadius="Party.VisionRadius"
                         PartyDraggable="PartyDraggable" PartyMoved="OnPartyMoved" PartyClicked="TogglePartyMenu"
                         MapOverlay="PartyMenu" />
    }
    else
    {
        <p class="muted map-message">Loading map&hellip;</p>
    }

    <nav class="map-tool-bar" role="toolbar" aria-label="Map tools">
        @foreach ((MapTool tool, string glyph, string label) in Tools)
        {
            MapTool candidate = tool;
            <button type="button" class="map-tool @(selection.Active == candidate ? "active" : string.Empty)"
                    aria-pressed="@(selection.Active == candidate ? "true" : "false")"
                    title="@ToolTitle(candidate, label)"
                    @onclick="e => Pick(candidate, e.ShiftKey)">
                <span class="tool-glyph" aria-hidden="true">@glyph</span>
                <span class="tool-label">@label</span>
                <span class="tool-key" aria-hidden="true">@ToolIndex(candidate)</span>
            </button>
        }
    </nav>

    @if (selection.Active != MapTool.Look)
    {
        <div class="map-tool-options">
            @if (selection.Active == MapTool.Fog)
            {
                <div class="brush-size" role="group" aria-label="Fog brush size">
                    Brush
                    @foreach (int size in BrushSizes)
                    {
                        int candidate = size;
                        <button type="button" class="brush @(brushCells == candidate ? "active" : string.Empty)"
                                aria-pressed="@(brushCells == candidate ? "true" : "false")"
                                title="@($"{candidate}×{candidate} cells")"
                                @onclick="() => brushCells = candidate">@candidate</button>
                    }
                </div>
            }
            else if (selection.Active == MapTool.Measure)
            {
                @* Both figures, because they answer different questions — see MapMeasurement. The rules
                   distance leads, since that is the one that settles whether a move or a reach is legal. *@
                <span class="measure-readout" role="status">
                    @if (!measured.IsSet)
                    {
                        <span class="muted">Nothing measured yet</span>
                    }
                    else if (measured.HasGrid)
                    {
                        <strong class="measure-feet">@measured.Feet ft</strong>
                        <span class="measure-squares">@Squares(measured.Squares)</span>
                        <span class="measure-straight" title="The true straight-line distance. Counting squares under-counts a diagonal, so this is the larger figure whenever the line is not straight along the grid.">
                            straight @measured.StraightFeet ft
                        </span>
                    }
                    else
                    {
                        <strong class="measure-feet">~@measured.StraightFeet ft</strong>
                        <span class="measure-straight">this map has no calibrated grid</span>
                    }

                    @if (measured.IsSet)
                    {
                        <button type="button" class="measure-clear" title="Take the line off the map"
                                @onclick="() => measured = MapMeasurement.None">Clear</button>
                    }
                </span>
            }
            else if (selection.Active == MapTool.Ping && Session.Ping.IsSet)
            {
                <span class="ping-readout" role="status">
                    <span class="ping-live">Pointing at the projector</span>
                    <button type="button" class="measure-clear" title="Take the pointer off both maps"
                            @onclick="Session.ClearPing">Clear</button>
                </span>
            }

            <p class="map-hint">@ToolHint <span class="map-hint-after">@AfterUseHint</span></p>
        </div>
    }

    <div class="map-footer">
        <label class="grid-toggle">
            <input type="checkbox" @bind="showGrid" />
            Grid
        </label>

        @if (Session.Ping.IsSet && selection.Active != MapTool.Ping)
        {
            @* Where the DM last pointed stays on their map whatever tool is up, so taking it down
               must not need the Point tool picked first. *@
            <button type="button" class="map-foot-btn" title="Take the pointer off both maps"
                    @onclick="Session.ClearPing">Clear point</button>
        }

        @if (Session.CanUndoPartyMove)
        {
            <button type="button" class="map-foot-btn party-undo" title="Take back what the party's last move showed, and put the token back (Ctrl+Z)"
                    @onclick="Session.UndoPartyMove">Undo move</button>
        }

        @if (Workspace.MapLoaded && !Session.Party.IsPlaced)
        {
            <span class="party-hint">No party on this map yet: pick Party (4) and click where they stand.</span>
        }

        @if (confirmingClear)
        {
            <span class="clear-confirm">Hide everything from the players again?</span>
            <button type="button" class="map-foot-btn clear-yes" @onclick="ConfirmClear">Clear all</button>
            <button type="button" class="map-foot-btn" @onclick="() => confirmingClear = false">Cancel</button>
        }
        else
        {
            <button type="button" class="map-foot-btn" title="Hide every revealed region, feature and painted cell on this map"
                    @onclick="() => confirmingClear = true">Clear reveals&hellip;</button>
            @if (Session.CanUndoClearReveals)
            {
                <button type="button" class="map-foot-btn clear-undo" title="Put back what the last clear hid"
                        @onclick="Session.UndoClearReveals">Undo clear</button>
            }
        }
    </div>

    @if (Workspace.MapLoaded && !string.IsNullOrEmpty(Workspace.AnnotationsWarning))
    {
        <p class="error map-warning" role="alert">@Workspace.AnnotationsWarning</p>
    }
</div>

@code {
    /// <summary>Raised after a click looked at a room, so the dock can show it on the Room tab.</summary>
    [Parameter]
    public EventCallback OnLooked { get; set; }

    // The toolbar, in order; the index of each entry is also its keyboard shortcut (1-8). The Party
    // tool took the lifter's place, so the numbers did not move.
    private static readonly (MapTool Tool, string Glyph, string Label)[] Tools =
    {
        (MapTool.Look, "☞", "Look"),
        (MapTool.Reveal, "◍", "Reveal"),
        (MapTool.Fog, "▨", "Fog"),
        (MapTool.Party, "◉", "Party"),
        (MapTool.Doors, "⌸", "Doors"),
        (MapTool.Conceal, "◐", "Conceal"),
        (MapTool.Measure, "⟺", "Measure"),
        (MapTool.Ping, "◎", "Point"),
    };

    private static readonly int[] BrushSizes = { 1, 2, 3 };

    // The vision ranges the token's menu offers in one click; any other is typed.
    private static readonly int[] VisionPresets = { 30, 60, 120 };

    private readonly ToolSelection selection = new ToolSelection();

    private VectorMapCanvas canvas;
    private bool showGrid;
    private int brushCells = 1;
    private bool confirmingClear;
    private bool partyMenuOpen;

    // The last distance measured. Kept on the pane rather than the shared workspace: it is one DM's
    // scratch working, of no interest to the players and of none to a second DM window either.
    private MapMeasurement measured = MapMeasurement.None;

    /// <summary>
    /// Picks the tool at a 1-based toolbar position (the <c>1</c>–<c>8</c> shortcuts, Shift to keep a
    /// one-click tool up).
    /// </summary>
    /// <param name="index">The toolbar position, 1 through 8; out-of-range values are ignored.</param>
    /// <param name="keep">True when Shift was held.</param>
    public void SelectToolByIndex(int index, bool keep)
    {
        if (index < 1 || index > Tools.Length)
        {
            return;
        }

        Pick(Tools[index - 1].Tool, keep);
        StateHasChanged();
    }

    /// <summary>Puts the map back in Look and closes the party token's menu, as Esc does.</summary>
    public void ResetTool()
    {
        selection.Reset();
        confirmingClear = false;
        partyMenuOpen = false;
        StateHasChanged();
    }

    /// <summary>
    /// Pans the map so a world point sits at the centre of the canvas (the Room tab's Centre action).
    /// </summary>
    /// <param name="worldX">Target X in world units.</param>
    /// <param name="worldY">Target Y in world units.</param>
    /// <param name="zoomFactor">Zoom to apply about the centre; 1 leaves the zoom alone.</param>
    /// <returns>A task that completes once the view has been moved.</returns>
    public Task CenterOnAsync(double worldX, double worldY, double zoomFactor) =>
        canvas is null ? Task.CompletedTask : canvas.CenterOnAsync(worldX, worldY, zoomFactor);

    /// <summary>
    /// Moves the map's view as the dock changes layout (see <see cref="MapViewMemory"/>): keeps the view
    /// of the layout being left, then brings back the new layout's view or frames the fight's room. Must
    /// be called after the render that changed the layout, so the map is measured at its new size.
    /// </summary>
    /// <param name="change">What to keep, what to bring back, and whether to frame the fight.</param>
    /// <param name="fight">The fight's room and its surroundings, in world units, for framing.</param>
    /// <returns>A task that completes once the view has moved.</returns>
    public async Task ChangeViewAsync(MapViewChange change, MapBounds fight)
    {
        if (canvas is null)
        {
            return;
        }

        if (change.SaveAs != DockLayout.None)
        {
            await canvas.SaveViewAsync(change.SaveAs.ToString());
        }

        if (change.FrameFight)
        {
            await canvas.FitAsync(fight);
        }
        else if (change.RestoreFrom != DockLayout.None)
        {
            await canvas.RestoreViewAsync(change.RestoreFrom.ToString());
        }
    }

    private void Pick(MapTool tool, bool keep)
    {
        selection.Pick(tool, keep);
        confirmingClear = false;
        partyMenuOpen = false;
    }

    private static int ToolIndex(MapTool tool) => Array.FindIndex(Tools, entry => entry.Tool == tool) + 1;

    private static string ToolTitle(MapTool tool, string label) => tool switch
    {
        MapTool.Look => "Look (1, or Esc): click a room to read it, click a door to open or close it",
        _ when ToolSelection.IsOneClick(tool) => $"{label} ({ToolIndex(tool)}): back to Look after one click. Hold Shift to keep it.",
        _ => $"{label} ({ToolIndex(tool)}): stays until Esc",
    };

    private static string Squares(int squares) => squares == 1 ? "1 square" : $"{squares} squares";

    private void ConfirmClear()
    {
        confirmingClear = false;
        Session.ClearReveals();
    }

    private string EditorToolName() => selection.Active switch
    {
        MapTool.Fog => "fog",
        MapTool.Measure => "measure",
        _ => "select",
    };

    private string ToolHint => selection.Active switch
    {
        MapTool.Reveal => "Reveal: click a room, door or marker to show or hide it for the players.",
        MapTool.Doors => "Doors: click a door to open or close it. Click a secret door to discover it (then open or close it); click again to hide it.",
        MapTool.Conceal => ConcealHint,
        MapTool.Fog => "Fog brush: drag to reveal grid cells; hold Alt (or right-drag) to hide them again.",
        MapTool.Party => "Party: click where the party stands. The token goes there and shows what the party sees from there, nothing on the way (the stairs, a teleport). To walk, drag the token.",
        MapTool.Measure => "Measure: drag between two points. Squares are counted the 5e way (a diagonal costs one). Only you see it.",
        MapTool.Ping => "Point: click a spot to point at it on the projector. It pulses a few times and fades.",
        _ => string.Empty,
    };

    private string AfterUseHint
    {
        get
        {
            if (!ToolSelection.IsOneClick(selection.Active))
            {
                return "Esc for Look.";
            }

            return selection.Kept ? "Kept until Esc." : "Back to Look after one click; Shift-pick to keep it.";
        }
    }

    // Nothing on this map is concealable until it is marked so in the Room editor, and a mode that
    // silently does nothing is worse than one that says why.
    private string ConcealHint => Workspace.ConcealedObjectIds.Count > 0
        ? $"Conceal: click one of the {Workspace.ConcealedObjectIds.Count} ghosted object(s) to show it to the players; click it again to hide it."
        : "Conceal: no concealed objects on this map yet. Mark a decoration or staircase 'Concealed' in the Room editor first.";

    private EditorOverlay BuildOverlay() => new EditorOverlay
    {
        Regions = Workspace.Regions,
        Markers = Workspace.Markers,
        HitTargets = ToolHitTargets(),
        SelectedRegionId = Workspace.SelectedRegionId,
        // The measured line is shown only while its own tool is up: it is working-out, and leaving
        // it lying across the map while the DM is revealing rooms would just be clutter. The ping
        // mark stays whatever tool is up, because "where did I point?" is a question the DM asks
        // while doing something else.
        Measure = selection.Active == MapTool.Measure ? measured : MapMeasurement.None,
        Ping = Session.Ping,
        UnitSize = Workspace.UnitSize,
    };

    // Each tool that acts on objects gets click targets over exactly those, as MapHitTargets
    // explains, and every other tool gets none, so its clicks reach the regions.
    private IReadOnlyList<ObjectHighlight> ToolHitTargets() => selection.Active switch
    {
        MapTool.Look => MapHitTargets.LookDoors(Workspace.Map, Workspace.SecretDoorIds, Session.RevealedFeatureIds()),
        MapTool.Doors => MapHitTargets.Doors(Workspace.Map),
        MapTool.Conceal => MapHitTargets.Concealed(Workspace.Map, Workspace.ConcealedObjectIds),
        _ => Array.Empty<ObjectHighlight>(),
    };

    // A map click goes to the tool that is up. A one-click tool that did something hands the map back
    // to Look.
    private Task OnCanvasClicked(CanvasClick click)
    {
        partyMenuOpen = false;
        if (selection.Active == MapTool.Look)
        {
            return LookClick(click);
        }

        // The fog brush and measuring are drags, so a stray click with either means nothing.
        bool acted = selection.Active switch
        {
            MapTool.Reveal => RevealClick(click),
            MapTool.Doors => DoorClick(click),
            MapTool.Conceal => ConcealClick(click),
            MapTool.Party => PlaceParty(click),
            MapTool.Ping => PingClick(click),
            _ => false,
        };

        if (acted)
        {
            selection.Used();
        }

        return Task.CompletedTask;
    }

    // Look: a door opens or closes; anything else looks at the room under the click. A marker or a
    // stair over a room counts as the room, which is what the DM meant by clicking there. An undiscovered
    // secret door has no click target in Look (MapHitTargets.LookDoors), so it reads as its room too.
    private Task LookClick(CanvasClick click)
    {
        if (string.Equals(click.HitKind, "door", StringComparison.Ordinal) && !string.IsNullOrEmpty(click.HitId))
        {
            DoorState before = Session.DoorStateOf(click.HitId);
            Session.ToggleDoorOpen(click.HitId);
            Party.AfterDoor(before);
            return Task.CompletedTask;
        }

        string regionId = string.Equals(click.HitKind, "region", StringComparison.Ordinal) && !string.IsNullOrEmpty(click.HitId)
            ? click.HitId
            : MapFraming.RegionAt(Workspace.Regions, click.WorldX, click.WorldY);
        if (regionId.Length == 0)
        {
            return Task.CompletedTask;
        }

        Workspace.SelectRegion(regionId);
        return OnLooked.InvokeAsync();
    }

    // Point at a spot on the projector. Deliberately not tied to a region or a reveal: the DM
    // points at a doorway, a stretch of corridor or a bit of fog just as often as at a room, and
    // requiring something to be under the click would make the tool useless exactly then.
    private bool PingClick(CanvasClick click)
    {
        Session.PingAt(click.WorldX, click.WorldY);
        return true;
    }

    // A finished measuring drag: the numbers come from the server so the committed line and the
    // readout can never disagree with each other.
    private void OnMeasured(CanvasSegment segment) =>
        measured = MapMeasure.Between(
            Workspace.Map.Grid, segment.FromX, segment.FromY, segment.ToX, segment.ToY);

    private bool RevealClick(CanvasClick click)
    {
        if (string.IsNullOrEmpty(click.HitId))
        {
            return false;
        }

        switch (click.HitKind)
        {
            case "region":
                Session.ToggleRegion(click.HitId);
                return true;
            case "feature":
            case "door":
            case "stairs":
                Session.ToggleFeature(click.HitId);
                return true;
            default:
                return false;
        }
    }

    // Doors: a left-click on a door cycles its state for the players. A normal door toggles
    // closed <-> open. A secret door cycles undiscovered (wall) -> discovered & closed -> open ->
    // undiscovered again, so a single button both discovers and re-hides it without a modifier key.
    private bool DoorClick(CanvasClick click)
    {
        if (!string.Equals(click.HitKind, "door", StringComparison.Ordinal) || string.IsNullOrEmpty(click.HitId))
        {
            return false;
        }

        string id = click.HitId;
        DoorState before = Session.DoorStateOf(id);
        ChangeDoor(id);
        Party.AfterDoor(before);
        return true;
    }

    private void ChangeDoor(string id)
    {
        if (!Workspace.SecretDoorIds.Contains(id))
        {
            Session.ToggleDoorOpen(id);
            return;
        }

        bool discovered = new HashSet<string>(Session.RevealedFeatureIds(), StringComparer.Ordinal).Contains(id);
        bool open = new HashSet<string>(Session.OpenDoorIds(), StringComparer.Ordinal).Contains(id);
        if (discovered && !open)
        {
            // Discovered and closed -> open it for the players.
            Session.SetDoorOpen(id, true);
            return;
        }

        // Either not yet discovered (discover it, closed) or discovered-and-open (re-hide it): both
        // flip the discovered state and leave the door closed. ToggleFeature does the flip either way.
        Session.SetDoorOpen(id, false);
        Session.ToggleFeature(id);
    }

    // Conceal: a click on a concealed object shows it to the players; clicking it again hides it
    // again. It rides the same reveal set a discovered secret door uses, so the DM has one notion of
    // "the players have seen this". Objects the editor did not mark concealed are inert here.
    private bool ConcealClick(CanvasClick click)
    {
        if (string.IsNullOrEmpty(click.HitId) || !Workspace.ConcealedObjectIds.Contains(click.HitId))
        {
            return false;
        }

        Session.ToggleFeature(click.HitId);
        return true;
    }

    // The Party tool: the token goes where the DM clicked, and the party sees from there only.
    private bool PlaceParty(CanvasClick click)
    {
        Party.Move(click.WorldX, click.WorldY, PartyMoveKind.Place);
        return true;
    }

    // ---- The party token ----------------------------------------------------------------------

    // The fog brush and measuring own the drag; under them the token lets the pointer through.
    private bool PartyDraggable => selection.Active != MapTool.Fog && selection.Active != MapTool.Measure;

    private void OnPartyMoved(PartyStep step)
    {
        partyMenuOpen = false;
        Party.Move(step.WorldX, step.WorldY, step.Kind);
    }

    private void TogglePartyMenu() => partyMenuOpen = !partyMenuOpen;

    private void SetVision(int feet) => Party.SetVision(feet);

    private void OnVisionTyped(ChangeEventArgs change)
    {
        if (int.TryParse(Convert.ToString(change.Value, System.Globalization.CultureInfo.InvariantCulture), out int feet))
        {
            Party.SetVision(feet);
        }
    }

    private void RemoveParty()
    {
        partyMenuOpen = false;
        Party.Remove();
    }

    // The token's menu, beside the token (dt-party.js places it): how far the party sees. A range
    // changed here shows straight away what the party sees with it.
    private RenderFragment PartyMenu => @<text>
        @if (partyMenuOpen && Session.Party.IsPlaced)
        {
            <div class="dt-party-pop" role="dialog" aria-label="Party">
                <div class="party-pop-title">Party vision</div>
                <div class="party-vision" role="group" aria-label="Vision range">
                    @foreach (int feet in VisionPresets)
                    {
                        int candidate = feet;
                        <button type="button" class="vision-preset @(Session.Party.VisionFeet == candidate ? "active" : string.Empty)"
                                aria-pressed="@(Session.Party.VisionFeet == candidate ? "true" : "false")"
                                @onclick="() => SetVision(candidate)">@candidate ft</button>
                    }
                    <input type="number" class="vision-feet" min="5" max="120" step="5" value="@Session.Party.VisionFeet"
                           aria-label="Vision range in feet" @onchange="OnVisionTyped" />
                    <span>ft</span>
                </div>
                <button type="button" class="party-pop-remove" @onclick="RemoveParty">Take the token off the map</button>
            </div>
        }
    </text>;

    // The fog brush reports a world point; paint (or erase) the brush-sized block of cells over it.
    private void OnFogPainted(FogPaint paint) =>
        Session.PaintCells(GridCells.BrushCells(Workspace.Map.Grid, paint.WorldX, paint.WorldY, brushCells), paint.Erase);

    private void OnBoxChanged(MapBounds viewport) =>
        Session.SetPlayerViewport(MapFraming.ClampToMap(viewport, Workspace.Map.Bounds));

    // The DM sees the whole map under a translucent tint over anything the players cannot yet see;
    // revealed regions and painted cells show through. Markers stay on the editor overlay (all of
    // them), so the fog layer draws none itself here.
    private FogOverlay BuildFog()
    {
        if (!Workspace.MapLoaded)
        {
            return FogOverlay.None;
        }

        return new FogOverlay
        {
            Enabled = true,
            FogColour = "#1b2436",
            FogOpacity = 0.5,
            RevealedPolygons = RevealedPolygons(),
            RevealedCells = RevealedCells(),
            UnitSize = Workspace.UnitSize,
        };
    }

    private IReadOnlyList<IReadOnlyList<MapPoint>> RevealedPolygons()
    {
        var revealed = new HashSet<string>(Session.RevealedRegionIds(), StringComparer.Ordinal);
        var polygons = new List<IReadOnlyList<MapPoint>>();
        foreach (Region region in Workspace.Regions)
        {
            if (revealed.Contains(region.RegionId) && region.Polygon.Count >= 3)
            {
                polygons.Add(region.Polygon);
            }
        }

        return polygons;
    }

    private IReadOnlyList<MapBounds> RevealedCells()
    {
        var cells = new List<MapBounds>();
        foreach ((int col, int row) in Session.FogCells())
        {
            cells.Add(GridCells.CellBounds(Workspace.Map.Grid, col, row));
        }

        return cells;
    }
}
