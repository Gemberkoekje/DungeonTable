@implements IDisposable
@inject BattleState Fight
@inject CampaignState Campaign
@*
    The Room tab's "what's in this room, and put it in a fight" strip. Its rows are the area's
    authored creatures with their authored counts. The count is a pre-fill on a stepper, never
    authoritative.

    Adding never fails: a creature with no extracted stat block still joins the fight with a name and
    editable numbers, because a missing extraction must not stop the DM running the encounter.

    Each row also ticks off. A campaign that runs for months keeps asking "have we been here, and did
    we kill the things in it?", and nothing else in the app can answer: the dossier says what the book
    puts in the room, the fight says what is happening now, and neither remembers three sessions ago.
    "Area cleared" is read off the ticks rather than stored beside them, so the two cannot disagree.

    A row of several counts down one at a time (-1, and +1 to take one back). One somebody or one band
    listed in several rooms is the same somebody in each (CreatureStanding): dealt with here is dealt
    with everywhere, so such a row can also flee, which takes it out of this room only.

    Move puts a creature in another room, whether that room lists it or not: the guard who stayed behind
    when the boss fled. The room it went to shows it with "moved here from", and either room's arrow
    takes the move back.
*@

<section class="encounter @(AllCleared ? "encounter-cleared" : string.Empty)" aria-label="Encounter">
    <header class="encounter-head">
        <h3>Encounter</h3>

        @if (Monsters.Count > 0)
        {
            <span class="encounter-progress @(AllCleared ? "all-clear" : string.Empty)" role="status">
                @if (AllCleared)
                {
                    @* The gap is inside the span: Razor trims the whitespace around a <text> block,
                       so a plain space between the two would be swallowed and read "✔Area cleared". *@
                    <span aria-hidden="true">&#x2714;&nbsp;</span>
                    <text>Area cleared</text>
                }
                else
                {
                    @($"{ClearedCount} of {Monsters.Count} dealt with")
                }
            </span>

            <button type="button" class="encounter-clear-all"
                    title="@(AllCleared ? "Put every creature back on the board" : "Tick every creature here off as dealt with")"
                    @onclick="ToggleAllCleared">@(AllCleared ? "Reopen area" : "Mark all dealt with")</button>

            <button type="button" class="encounter-add-all" title="Put every creature listed here into the battle"
                    @onclick="AddAll">Add all to battle</button>
        }
    </header>

    @if (Monsters.Count == 0)
    {
        <p class="muted">Nobody is listed in this area.</p>
    }
    else
    {
        <ul class="encounter-list">
            @foreach (EncounterMonster monster in Monsters)
            {
                EncounterMonster row = monster;
                CreatureStanding standing = StandingOf(row);
                bool cleared = standing.Gone;
                string status = StatusOf(standing);
                <li class="encounter-row @(cleared ? "cleared" : string.Empty)">
                    @* A checkbox, not a button: this is a record of what happened, and it is the one
                       control on the row a DM might tab through a list of. *@
                    <label class="encounter-done" title="@DoneTitle(row, standing)">
                        <input type="checkbox" checked="@cleared"
                               aria-label="@($"{row.Name} dealt with")"
                               @onchange="() => ToggleDone(row)" />
                    </label>

                    <button type="button" class="encounter-name ref-link" title="Open the stat block"
                            @onclick="() => OnOpenReference.InvokeAsync(row.NodeId)">@row.Name</button>

                    @if (row.Citation.Length > 0)
                    {
                        <span class="encounter-cite">@row.Citation</span>
                    }
                    @if (!row.HasStatBlock)
                    {
                        <span class="encounter-warn" title="No stat block is extracted — it still adds, with blank HP and AC">no stat block</span>
                    }
                    @if (row.Secret)
                    {
                        <span class="secret-badge" title="DM only — the players don't know these are here">DM</span>
                    }
                    @if (status.Length > 0)
                    {
                        <span class="encounter-status" title="@StatusTitle(row, standing)">@status</span>
                    }
                    @* The band's own count, where this room lists only some of it: a room that lists the
                       whole band says the same in its own chip. *@
                    @if (standing.BandSize > 1 && standing.Listed < standing.BandSize && !standing.GoneElsewhere)
                    {
                        <span class="encounter-band" title="@($"A band: {standing.BandLeft} of {standing.BandSize} still up, across every room that lists them")">@($"{standing.BandLeft} of {standing.BandSize} in all")</span>
                    }
                    @if (standing.MovedHere > 0 && standing.MovedFrom.Length > 0)
                    {
                        <span class="encounter-moved" title="@($"You moved {MovedWhat(row, standing.MovedHere)} here from {AreaLabel(standing.MovedFrom)}")">
                            @($"moved here from {ShortTitle(AreaLabel(standing.MovedFrom))}")
                            <button type="button" class="moved-undo" aria-label="@($"Send {row.Name} back to {AreaLabel(standing.MovedFrom)}")"
                                    title="@($"Take the move back: {MovedWhat(row, 0)} go back to {AreaLabel(standing.MovedFrom)}")"
                                    @onclick="() => Campaign.UndoMove(row.NodeId, AreaNodeId, into: true)">&#x21A9;</button>
                        </span>
                    }
                    @if (standing.MovedAway > 0 && standing.MovedTo.Length > 0)
                    {
                        <span class="encounter-moved moved-away" title="@($"You moved {MovedWhat(row, standing.MovedAway)} to {AreaLabel(standing.MovedTo)}")">
                            @MovedAwayText(row, standing)
                            <button type="button" class="moved-undo" aria-label="@($"Bring {row.Name} back here")"
                                    title="Take the move back: they are here again"
                                    @onclick="() => BringBack(row)">&#x21A9;</button>
                        </span>
                    }

                    <span class="encounter-context" title="@row.Context">@row.Context</span>

                    @if (row.CountExpression.Length > 0)
                    {
                        <span class="encounter-dice" title="The book rolls for this — roll it and type the result">@row.CountExpression</span>
                    }

                    @* Counting down and fleeing: what happens one creature at a time in a fight. *@
                    <span class="encounter-tally">
                        @if (CanCountDown(standing))
                        {
                            <button type="button" class="tally-down" title="One of them dealt with"
                                    aria-label="@($"One {row.Name} dealt with")"
                                    @onclick="() => Campaign.Count(AreaNodeId, row.NodeId, 1, 0)">&minus;1</button>
                        }
                        @if (CanTakeBack(standing))
                        {
                            <button type="button" class="tally-back" title="Take one back: one fewer dealt with"
                                    aria-label="@($"One {row.Name} back")"
                                    @onclick="() => Campaign.TakeBackOne(AreaNodeId, row.NodeId, standing.Listed)">+1</button>
                        }
                        @if (row.Shared && standing.FledHere > 0)
                        {
                            <button type="button" class="tally-fled on" aria-pressed="true"
                                    title="Fled from here, still up wherever else they are listed. Click to bring them back"
                                    @onclick="() => Campaign.Count(AreaNodeId, row.NodeId, 0, -standing.FledHere)">
                                <span aria-hidden="true">&#x21AA;</span> @(standing.FledHere > 1 ? $"{standing.FledHere} fled" : "fled")
                            </button>
                        }
                        @if (row.Shared && !cleared)
                        {
                            <button type="button" class="tally-flee"
                                    title="@(standing.Left > 1 ? "One of them fled from here: still up wherever else they are listed" : "Fled from here: still up wherever else listed, so not dealt with")"
                                    @onclick="() => Campaign.Count(AreaNodeId, row.NodeId, 0, 1)">
                                <span aria-hidden="true">&#x21AA;</span> @(standing.Left > 1 ? "one fled" : "fled")
                            </button>
                        }
                    </span>

                    @if (OnMove is not null && !cleared)
                    {
                        <button type="button" class="encounter-move" aria-expanded="@(IsMoving(row) ? "true" : "false")"
                                title="Move them to another room: the room they go to shows them from then on"
                                @onclick="() => ToggleMove(row, standing)"><span aria-hidden="true">&#x21A6;</span> Move</button>
                    }

                    <span class="encounter-stepper">
                        <button type="button" title="One fewer" @onclick="() => Step(row.NodeId, -1)">&minus;</button>
                        <input type="number" min="1" max="99" aria-label="@($"How many {row.Name}")"
                               value="@CountOf(row)" @onchange="e => SetCount(row.NodeId, e.Value)" />
                        <button type="button" title="One more" @onclick="() => Step(row.NodeId, 1)">+</button>
                    </span>

                    <button type="button" class="encounter-add" title="Add these to the battle"
                            @onclick="() => Add(row)">Add</button>
                </li>
                @if (IsMoving(row) && !cleared)
                {
                    IReadOnlyList<AreaDossier> targets = MoveTargets(moveFilter) ?? Array.Empty<AreaDossier>();
                    <li class="encounter-move-panel" aria-label="@($"Move {row.Name}")">
                        <div class="move-head">
                            <span class="move-what">Move</span>
                            @if (!row.Individual && (standing.Rolled || standing.Left > 1))
                            {
                                <span class="encounter-stepper">
                                    <button type="button" title="One fewer" @onclick="() => StepMove(-1, standing)">&minus;</button>
                                    <input type="number" min="1" max="@MostToMove(standing)" aria-label="@($"How many {row.Name} to move")"
                                           value="@moveCount" @onchange="e => SetMoveCount(e.Value, standing)" />
                                    <button type="button" title="One more" @onclick="() => StepMove(1, standing)">+</button>
                                </span>
                            }
                            <span class="move-what">@row.Name to</span>
                            @* Keys stop here: Esc cancels the move rather than going back to the party's room. *@
                            <input type="search" class="move-filter" placeholder="Find a room&hellip;" @ref="moveInput"
                                   aria-label="Find the room to move them to" value="@moveFilter"
                                   @oninput="e => moveFilter = e.Value as string ?? string.Empty"
                                   @onkeydown="e => MoveKey(e, row, targets)" @onkeydown:stopPropagation="true" />
                            <button type="button" class="move-cancel" @onclick="CancelMove">Cancel</button>
                        </div>
                        @if (targets.Count == 0)
                        {
                            <p class="muted move-none">No room matches.</p>
                        }
                        else
                        {
                            <ul class="move-targets">
                                @foreach (AreaDossier target in targets)
                                {
                                    string to = target.AreaNodeId;
                                    <li>
                                        <button type="button" class="move-target" title="@($"Move them to {target.Title}")"
                                                @onclick="() => FinishMove(row, to)">@target.Title</button>
                                    </li>
                                }
                            </ul>
                        }
                    </li>
                }
            }
        </ul>
    }

    @if (confirming)
    {
        <div class="encounter-confirm" role="alertdialog" aria-label="Replace the running battle">
            <p>
                A battle is already running in <strong>@RunningIn</strong>. Adding from here starts a new
                one &mdash; the current initiative order and all combatant state are lost.
            </p>
            <button type="button" class="danger" @onclick="ConfirmReplace">Start a new battle</button>
            <button type="button" @onclick="CancelReplace">Keep the current battle</button>
            <button type="button" @onclick="AddToRunning">Add to the running battle instead</button>
        </div>
    }
</section>

@code {
    /// <summary>The creatures this area names, from <see cref="DmWorkspace.Encounter"/>.</summary>
    [Parameter]
    public IReadOnlyList<EncounterMonster> Monsters { get; set; } = Array.Empty<EncounterMonster>();

    /// <summary>The node id of the area a fight started from here belongs to.</summary>
    [Parameter]
    public string AreaNodeId { get; set; } = string.Empty;

    /// <summary>The area's display title, for the Battle tab header.</summary>
    [Parameter]
    public string AreaTitle { get; set; } = string.Empty;

    /// <summary>Raised with a node id when the DM clicks a creature's name, to open its stat block.</summary>
    [Parameter]
    public EventCallback<string> OnOpenReference { get; set; }

    /// <summary>An area's name by its node id, for "dealt with in ..."; the id itself when not given.</summary>
    [Parameter]
    public Func<string, string> AreaLabel { get; set; } = id => id;

    /// <summary>The rooms a creature here can be moved to, best first, for what the DM typed (see <see cref="DmWorkspace.MoveTargets"/>).</summary>
    [Parameter]
    public Func<string, IReadOnlyList<AreaDossier>> MoveTargets { get; set; } = _ => Array.Empty<AreaDossier>();

    /// <summary>
    /// Moves a creature from this area: the row, the area it goes to and how many. Without it the rows
    /// offer no Move.
    /// </summary>
    [Parameter]
    public Action<EncounterMonster, string, int> OnMove { get; set; }

    // Steppers the DM has adjusted, keyed by node id. Anything absent shows the authored pre-fill, so
    // navigating to another area and back does not strand a count from a different room.
    private readonly Dictionary<string, int> counts = new Dictionary<string, int>(StringComparer.Ordinal);

    // What the pending confirm will do once the DM says yes: a single row, or the whole strip.
    private EncounterMonster pending;
    private bool pendingAll;
    private bool confirming;
    private string lastArea = string.Empty;

    // The row whose Move is open, by node id, what the DM typed to find the room, and how many go.
    private string movingId = string.Empty;
    private string moveFilter = string.Empty;
    private int moveCount = 1;
    private bool focusMove;
    private ElementReference moveInput;

    protected override void OnInitialized()
    {
        Fight.Changed += OnBattleChanged;

        // The ticks are shared table state, so a second DM window (or a restore) must be seen here.
        Campaign.Changed += OnBattleChanged;
    }

    // How many of the creatures this area lists are gone from it, and whether that is all of them.
    // Counted against the shown rows, never against everything stored: a tick left behind by a
    // creature the area no longer lists must not make a room read as more cleared than it is.
    private int ClearedCount => Monsters.Count(monster => StandingOf(monster).Gone);

    private bool AllCleared => Monsters.Count > 0 && ClearedCount == Monsters.Count;

    private CreatureStanding StandingOf(EncounterMonster row) => CreatureStanding.Of(AreaNodeId, row, Campaign);

    private void ToggleAllCleared()
    {
        bool reopen = AllCleared;
        foreach (EncounterMonster row in Monsters)
        {
            CreatureStanding standing = StandingOf(row);
            if (reopen)
            {
                PutBack(row);
            }
            else if (!standing.Gone)
            {
                DealWith(row, standing);
            }
        }
    }

    private void ToggleDone(EncounterMonster row)
    {
        CreatureStanding standing = StandingOf(row);
        if (standing.Gone)
        {
            PutBack(row);
        }
        else
        {
            DealWith(row, standing);
        }
    }

    // Every one still here dealt with. A kind of creature is ticked off whole, which stays true if an
    // edit changes its count. One somebody or a band is counted, exactly what is left here, so the
    // band elsewhere loses no more than this room had.
    private void DealWith(EncounterMonster row, CreatureStanding standing)
    {
        // A row some were moved into or out of is counted, never ticked whole: taking a move back must
        // bring creatures back that a whole tick would hide.
        if (!row.Shared && standing.MovedHere == 0 && standing.MovedAway == 0)
        {
            if (!Campaign.RecordOf(AreaNodeId, row.NodeId).Whole)
            {
                Campaign.ToggleCreatureCleared(AreaNodeId, row.NodeId);
            }

            return;
        }

        Campaign.Count(AreaNodeId, row.NodeId, standing.Rolled ? 1 : standing.Left, 0);
    }

    // Back on the board as the book lists them. One somebody or a band still gone after that was dealt
    // with in another room, and putting them back means everywhere: he is alive again, and so is the band.
    // Moved away, they come back here first.
    private void PutBack(EncounterMonster row)
    {
        if (StandingOf(row).MovedElsewhere)
        {
            BringBack(row);
        }

        Campaign.PutBack(AreaNodeId, row.NodeId);
        if (row.Shared && StandingOf(row).Gone)
        {
            Campaign.PutBackEverywhere(row.NodeId);
        }
    }

    // Moved away from here, and brought back: one somebody this room lists is where the book has him
    // again; anything else comes back from the last room it was moved to from here.
    private void BringBack(EncounterMonster row)
    {
        if (row.Individual && !row.MovedHere)
        {
            Campaign.ForgetMoves(row.NodeId, AreaNodeId, oneSomebody: true);
        }
        else
        {
            Campaign.UndoMove(row.NodeId, AreaNodeId, into: false);
        }
    }

    private bool IsMoving(EncounterMonster row) => string.Equals(movingId, row.NodeId, StringComparison.Ordinal);

    private void ToggleMove(EncounterMonster row, CreatureStanding standing)
    {
        if (IsMoving(row))
        {
            CancelMove();
            return;
        }

        movingId = row.NodeId;
        moveFilter = string.Empty;
        moveCount = Math.Clamp(standing.Rolled ? CountOf(row) : standing.Left, 1, MostToMove(standing));
        focusMove = true;
    }

    private void CancelMove()
    {
        movingId = string.Empty;
        moveFilter = string.Empty;
        focusMove = false;
    }

    // A count still to be rolled moves as many as the DM says; any other no more than are left.
    private static int MostToMove(CreatureStanding standing) =>
        standing.Rolled ? EncounterCount.MaxCount : Math.Max(standing.Left, 1);

    private void StepMove(int delta, CreatureStanding standing) =>
        moveCount = Math.Clamp(moveCount + delta, 1, MostToMove(standing));

    private void SetMoveCount(object value, CreatureStanding standing)
    {
        if (int.TryParse(value as string, out int typed))
        {
            moveCount = Math.Clamp(typed, 1, MostToMove(standing));
        }
    }

    // Enter takes the first room listed, Esc puts the move away.
    private void MoveKey(KeyboardEventArgs e, EncounterMonster row, IReadOnlyList<AreaDossier> targets)
    {
        if (e.Key == "Escape")
        {
            CancelMove();
        }
        else if (e.Key == "Enter" && targets.Count > 0)
        {
            FinishMove(row, targets[0].AreaNodeId);
        }
    }

    private void FinishMove(EncounterMonster row, string toAreaNodeId)
    {
        int count = moveCount;
        CancelMove();
        counts.Remove(row.NodeId);
        OnMove?.Invoke(row, toAreaNodeId, count);
    }

    // "Grask", "3 goblins", or the row's name when the number does not matter.
    private static string MovedWhat(EncounterMonster row, int count) =>
        row.Individual || count <= 1 ? row.Name : $"{count} {row.Name}";

    private string MovedAwayText(EncounterMonster row, CreatureStanding standing)
    {
        string where = ShortTitle(AreaLabel(standing.MovedTo));
        return row.Individual || standing.MovedAway <= 1 || standing.MovedElsewhere
            ? "moved to " + where
            : $"{standing.MovedAway} moved to {where}";
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusMove && movingId.Length > 0)
        {
            focusMove = false;
            try
            {
                await moveInput.FocusAsync();
            }
            catch (InvalidOperationException)
            {
                // The panel closed before the focus got there.
            }
        }
    }

    private static bool CanCountDown(CreatureStanding standing) =>
        !standing.Rolled && standing.Listed > 1 && standing.Left > 0;

    private static bool CanTakeBack(CreatureStanding standing) =>
        !standing.Rolled && standing.Listed > 1 && standing.DealtHere > 0;

    // What the row's chip says: where one somebody was dealt with, that a whole band is gone, or how
    // many of a listing are left. Empty when the row is as the book lists it, or simply ticked off.
    private string StatusOf(CreatureStanding standing)
    {
        if (standing.GoneElsewhere)
        {
            if (standing.BandSize > 1)
            {
                return $"all {standing.BandSize} dealt with";
            }

            return standing.DealtIn.Count > 0 ? "dealt with in " + ShortTitle(AreaLabel(standing.DealtIn[0])) : "dealt with elsewhere";
        }

        return !standing.Rolled && standing.Left > 0 && standing.Left < standing.Listed
            ? $"{standing.Left} of {standing.Listed} left"
            : string.Empty;
    }

    // A room's name without its key in brackets, for the chip: "Bell-Founder's Workshop (Level 1, Area 4)"
    // reads "Bell-Founder's Workshop". The chip's tooltip keeps the whole title.
    private static string ShortTitle(string title)
    {
        int key = title.LastIndexOf(" (", StringComparison.Ordinal);
        return key > 0 && title.EndsWith(')') ? title[..key] : title;
    }

    private string StatusTitle(EncounterMonster row, CreatureStanding standing)
    {
        if (!standing.GoneElsewhere)
        {
            return standing.Shared
                ? "What is left here: counted down here, and across every room that lists them"
                : "What is left here, counted down one at a time";
        }

        string where = string.Join(", ", standing.DealtIn.Select(AreaLabel));
        return where.Length > 0
            ? $"{row.Name}: dealt with in {where}"
            : $"{row.Name}: dealt with elsewhere";
    }

    private static string DoneTitle(EncounterMonster row, CreatureStanding standing)
    {
        if (standing.GoneElsewhere)
        {
            return standing.BandSize > 1
                ? "The whole band is dealt with. Untick to put the band back on the board everywhere"
                : "Dealt with in another room. Untick to put them back on the board everywhere";
        }

        if (standing.MovedElsewhere)
        {
            return "Moved to another room. Untick to bring them back here";
        }

        if (standing.Gone)
        {
            return "Put these back on the board";
        }

        return row.Shared
            ? "These have been dealt with: here, and in every other room that lists them"
            : "These have been dealt with";
    }

    protected override void OnParametersSet()
    {
        // A different room means different creatures; drop the edited counts rather than carry a
        // "4" from the last room onto a same-named creature here.
        if (!string.Equals(lastArea, AreaNodeId, StringComparison.Ordinal))
        {
            lastArea = AreaNodeId;
            counts.Clear();
            CancelReplace();
            CancelMove();
        }
    }

    /// <summary>Unsubscribes from the battle and the campaign, both of which outlive this component.</summary>
    public void Dispose()
    {
        Fight.Changed -= OnBattleChanged;
        Campaign.Changed -= OnBattleChanged;
    }

    private void OnBattleChanged() => InvokeAsync(StateHasChanged);

    private string RunningIn
    {
        get
        {
            Battle running = Fight.Snapshot();
            return running.AreaTitle.Length > 0 ? running.AreaTitle : "another area";
        }
    }

    // The stepper starts at what is left here (all of it before anything is dealt with), so "Add"
    // brings the survivors into a fight, not the whole listing.
    private int CountOf(EncounterMonster monster)
    {
        if (counts.TryGetValue(monster.NodeId, out int edited))
        {
            return edited;
        }

        CreatureStanding standing = StandingOf(monster);
        return !standing.Rolled && standing.Left > 0 ? standing.Left : monster.SuggestedCount;
    }

    private void Step(string nodeId, int delta)
    {
        EncounterMonster monster = Monsters.FirstOrDefault(m => string.Equals(m.NodeId, nodeId, StringComparison.Ordinal));
        if (monster is not null)
        {
            counts[nodeId] = Math.Clamp(CountOf(monster) + delta, 1, 99);
        }
    }

    private void SetCount(string nodeId, object value)
    {
        if (int.TryParse(value as string, out int typed))
        {
            counts[nodeId] = Math.Clamp(typed, 1, 99);
        }
    }

    // Adding into a fight that is already running in a *different* area is the case worth asking
    // about: reinforcements arriving in the same room are the normal thing to want, and silently
    // discarding an evening's initiative order is not.
    private void Add(EncounterMonster monster)
    {
        if (NeedsConfirm())
        {
            pending = monster;
            pendingAll = false;
            confirming = true;
            return;
        }

        Commit(monster);
    }

    private void AddAll()
    {
        if (NeedsConfirm())
        {
            pending = null;
            pendingAll = true;
            confirming = true;
            return;
        }

        CommitAll();
    }

    private bool NeedsConfirm() =>
        Fight.IsActive && !string.Equals(Fight.AreaNodeId, AreaNodeId, StringComparison.Ordinal);

    private void ConfirmReplace()
    {
        Fight.StartBattle(AreaNodeId, AreaTitle);
        Finish();
    }

    private void AddToRunning() => Finish();

    private void CancelReplace()
    {
        pending = null;
        pendingAll = false;
        confirming = false;
    }

    // Apply whatever the confirm was holding, then clear it.
    private void Finish()
    {
        if (pendingAll)
        {
            CommitAll();
        }
        else if (pending is not null)
        {
            Commit(pending);
        }

        CancelReplace();
    }

    private void Commit(EncounterMonster monster)
    {
        EnsureBattle();
        Fight.AddEncounter(monster, CountOf(monster));
    }

    private void CommitAll()
    {
        EnsureBattle();
        foreach (EncounterMonster monster in Monsters)
        {
            Fight.AddEncounter(monster, CountOf(monster));
        }
    }

    // A first add from an area with no fight running opens one there, seeding the party, so the DM
    // never has to visit the Battle tab first.
    private void EnsureBattle()
    {
        if (!Fight.IsActive)
        {
            Fight.StartBattle(AreaNodeId, AreaTitle);
        }
    }
}
