@*
    The Info panel's Story sub-tab: the campaign that came before this one.

    A chapter per handoff document — the one-paragraph version, a cast table keyed on "is that one
    still alive", the story in collapsible sections, and the loose ends the dungeon can use.

    The cast table is the part that earns its place at the table. Everything else is read once in
    prep; "wait, didn't we kill him?" is asked mid-session, about a name a player just said.
*@

<section class="story-panel" aria-label="The campaign so far">
    @if (Chapters.Count == 0)
    {
        <p class="muted">No prior-campaign history is authored.</p>
    }
    else
    {
        @if (Chapters.Count > 1)
        {
            <nav class="story-chapters" role="group" aria-label="Chapters">
                @for (int i = 0; i < Chapters.Count; i++)
                {
                    int index = i;
                    <button type="button" class="quest-filter @(index == Shown ? "on" : string.Empty)"
                            @onclick="() => shown = index">@Chapters[index].Title</button>
                }
            </nav>
        }

        <article class="story-chapter">
            <header class="story-head">
                <h3>@Current.Title</h3>
                @if (Current.Source.Length > 0)
                {
                    <p class="muted story-source">@Current.Source</p>
                }
            </header>

            @if (Current.Summary.Length > 0)
            {
                <div class="story-summary">
                    <CrossRefProse Text="@Current.Summary" ResolveRefs="ResolveRefs" OnActivate="OnOpenReference" />
                </div>
            }

            @if (Current.Cast.Count > 0)
            {
                <h4>Cast</h4>
                <table class="cast-table">
                    <caption class="visually-hidden">Who they met, and where the handoff leaves them</caption>
                    <thead>
                        <tr>
                            <th scope="col">Who</th>
                            <th scope="col">What they were</th>
                            <th scope="col">State</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (CastMember member in Current.Cast)
                        {
                            <tr class="@(member.Secret ? "secret" : string.Empty)">
                                <th scope="row">
                                    @if (member.Ref.Length > 0 && OnOpenReference.HasDelegate)
                                    {
                                        <button type="button" class="ref-link" title="Open their card"
                                                @onclick="() => OnOpenReference.InvokeAsync(member.Ref)">@member.Name</button>
                                    }
                                    else
                                    {
                                        @member.Name
                                    }
                                    @if (member.Secret)
                                    {
                                        <span class="secret-badge" title="DM only — the players do not know this">DM</span>
                                    }
                                </th>
                                <td>@member.Role</td>
                                <td class="cast-state">@member.State</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (Current.Sections.Count > 0)
            {
                <h4>What they lived through</h4>
                @foreach (DossierBlock section in Current.Sections)
                {
                    @Block(section)
                }
            }

            @if (Current.LooseEnds.Count > 0)
            {
                <h4>Loose ends I can use</h4>
                @foreach (DossierBlock end in Current.LooseEnds)
                {
                    @Block(end)
                }
            }
        </article>
    }
</section>

@code {
    /// <summary>The table's prior-campaign history.</summary>
    [Parameter]
    public StoryLibrary Story { get; set; } = new StoryLibrary();

    /// <summary>
    /// Resolves cross-references in the handoff's prose. It ranges across another campaign
    /// entirely, so callers should pass the entity-only resolver: an "area 12" in a town
    /// house is never this floor's area 12.
    /// </summary>
    [Parameter]
    public Func<string, IReadOnlyList<CrossRef>> ResolveRefs { get; set; }

    /// <summary>Raised with a node id to open an entity's reference card.</summary>
    [Parameter]
    public EventCallback<string> OnOpenReference { get; set; }

    private int shown;

    private IReadOnlyList<StoryDossier> Chapters => Story.Chapters;

    // Clamped rather than indexed directly: the chapter list is authored content that can shrink
    // under a DM who has already clicked past the end of the new one.
    private int Shown => Chapters.Count == 0 ? 0 : Math.Clamp(shown, 0, Chapters.Count - 1);

    private StoryDossier Current => Chapters.Count == 0 ? new StoryDossier() : Chapters[Shown];

    private RenderFragment Block(DossierBlock block) =>
        @<details class="detail-block @(block.Secret ? "secret" : string.Empty)">
            <summary>
                <span class="detail-heading">@block.Heading</span>
                @if (block.Secret)
                {
                    <span class="secret-badge" title="DM only — don't read this aloud">secret</span>
                }
            </summary>
            <div class="detail-body"><CrossRefProse Text="@block.Body" ResolveRefs="ResolveRefs" OnActivate="OnOpenReference" /></div>
        </details>;
}
